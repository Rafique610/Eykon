# Persistent Memory App — Environment Variables
# Copy this file to .env to override default values:
# cp .env.example .env

# Ollama local server URL
# MEMORY_OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name for generation
# MEMORY_OLLAMA_MODEL=gemma2:2b

# Google LiteRT-LM model for mobile-ready edge generation
# MEMORY_LITERT_MODEL_REPO=litert-community/gemma-4-E2B-it-litert-lm
# MEMORY_LITERT_MODEL_FILE=gemma-4-E2B-it.litertlm
# MEMORY_LITERT_MODEL_PATH=

# Sentence-Transformers model for semantic vector embeddings
# MEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# SQLite database file path
# MEMORY_DB_PATH=data/memories.db

# Default top-k retrieved memories
# MEMORY_TOP_K=5
